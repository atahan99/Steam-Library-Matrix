# Docker Compose — copy to .env in this folder (never commit docker/.env)
# cp docker/.env.example docker/.env
#
# Self-contained self-host: separate DB from local dev (volume matrix_data).
# Do not reuse your local .env or ./data/matrix.db for Compose unless you intend to.
#
# Fast worker defaults are set in compose.yml (5s poll, parallel ticks, all sources on import including HLTB).
# Override below only if you need quieter/slower enrichment.

# Required — https://steamcommunity.com/dev/apikey (domain: localhost)
# Omit to reuse STEAM_API_KEY from the repo-root .env (see compose env_file order).
# STEAM_API_KEY=

# SQLite inside the container (Docker volume matrix_data)
DATABASE_URL=file:/app/data/matrix.db

# Embedded job worker (also enabled in compose.yml)
SLM_EMBED_JOB_WORKER=true

# Generate: openssl rand -hex 32
CRON_SECRET=

# Home lab only — omit on internet-facing hosts (see docs/security.md)
SLM_ALLOW_OPEN_API=true

# Public internet: set SLM_API_SECRET and do NOT set SLM_ALLOW_OPEN_API
# SLM_API_SECRET=

# Optional — slow down worker (defaults in compose.yml are tuned for speed)
# SLM_EMBED_WORKER_MS=5000
# SLM_WORKER_MAX_JOBS_PER_TICK=8
# SLM_RATE_LIMIT_PER_MIN=60
# STEAM_WISHLIST_LEGACY_FALLBACK=true
