# Docker Compose: copy to .env in this folder (never commit docker/.env)
# cp docker/.env.example docker/.env
#
# The database lives in the matrix_db volume (docker/db/README.md). App: http://localhost:3001
# Keys under environment: in compose.yml (DATABASE_URL, SLM_SEED_DIR, SLM_EMBED_*, SLM_WORKER_*,
# batch sizes, SLM_ENRICH_VERBOSE) override this file; edit compose.yml to change them.
# All variables: docs/env.md

# Required: https://steamcommunity.com/dev/apikey (domain: localhost)
# Omit to reuse STEAM_API_KEY from the repo-root .env (see compose env_file order).
# STEAM_API_KEY=

# SQLite inside the container (matrix_db volume); compose.yml sets the same value
DATABASE_URL=file:/app/data/db/matrix.db

# Bundled seed JSON inside the container (Compose mounts ../data/seed read-only)
SLM_SEED_DIR=/app/data/seed

# Embedded job worker (compose.yml sets this too)
SLM_EMBED_JOB_WORKER=true

# Optional with the embedded worker; only for HTTP calls to /api/cron/process-jobs
# Generate: openssl rand -hex 32
CRON_SECRET=

# Optional: outbound fetch timeout in ms (default 15000)
# SLM_FETCH_TIMEOUT_MS=15000

# These two have no effect while compose.yml sets them; edit compose.yml instead
# SLM_EMBED_WORKER_MS=5000
# SLM_WORKER_MAX_JOBS_PER_TICK=8

# Optional: API rate limit and legacy wishlist URL
# SLM_RATE_LIMIT_PER_MIN=60
# STEAM_WISHLIST_LEGACY_FALLBACK=true
