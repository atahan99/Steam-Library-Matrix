# Local Next.js dev — copy to .env (never commit .env)
# cp .env.example .env
#
# For Docker self-host use docker/.env.example → docker/.env instead (see README).

# Required — https://steamcommunity.com/dev/apikey (domain: localhost)
STEAM_API_KEY=

# SQLite for local dev (created by pnpm db:migrate under ./data/)
DATABASE_URL=file:./data/matrix.db

# Required for dev:jobs / dev:all background enrichments
# Generate: openssl rand -hex 32
CRON_SECRET=

# Home lab only — omit on internet-facing hosts (see docs/security.md)
SLM_ALLOW_OPEN_API=true

# Public internet: set SLM_API_SECRET and do NOT set SLM_ALLOW_OPEN_API
# SLM_API_SECRET=

# Do not set SLM_EMBED_JOB_WORKER locally — use pnpm dev:all (dev:jobs poller)

# Optional — skip auto AWACY/Levvvel/Denuvo catalog sync on server start
# SLM_SKIP_CATALOG_BOOTSTRAP=true

# Optional — do not auto-queue app_details job after library import
# SLM_SKIP_AUTO_APP_DETAILS=true

# Optional — enrichment throughput tuning (see docs/env.md)
# SLM_DEV_CRON_MS=5000
# SLM_ACHIEVEMENTS_BATCH=60
# SLM_PROTONDB_BATCH=40
# SLM_HLTB_BATCH=12

# Optional — enrichment CLI logging (dev:jobs enables verbose by default)
# SLM_ENRICH_VERBOSE=false
# SLM_DEV_JOBS_HTTP=true
# SLM_RATE_LIMIT_PER_MIN=60
# STEAM_WISHLIST_LEGACY_FALLBACK=true
