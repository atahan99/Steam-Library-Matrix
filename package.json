{
  "name": "steam-library-matrix",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ],
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "0.28.1",
      "cheerio>undici": "7.29.0",
      "hono": "4.12.32",
      "undici": "7.29.0"
    }
  },
  "scripts": {
    "dev": "next dev",
    "dev:jobs": "tsx --env-file=.env scripts/dev-cron-loop.ts",
    "dev:all": "tsx scripts/dev-all.ts",
    "build": "next build",
    "docker:bundle-entrypoint": "node docker/bundle-entrypoint.mjs",
    "docker:up": "docker compose -f docker/compose.yml up --build -d",
    "docker:down": "docker compose -f docker/compose.yml down",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run --exclude '**/*.live.test.ts'",
    "test:anticheat": "vitest run src/lib/anticheat",
    "test:denuvo": "vitest run src/lib/steam/denuvo --exclude '**/*.live.test.ts'",
    "test:denuvo:live": "vitest run src/lib/steam/denuvo/check-steam-denuvo.live.test.ts",
    "test:denuvo:print": "tsx scripts/print-denuvo-results.ts",
    "inspect:anticheat-catalogs": "tsx --env-file=.env scripts/inspect-anticheat-catalogs.ts",
    "setup:anticheat": "tsx --env-file=.env scripts/setup-anticheat-and-denuvo.ts",
    "bootstrap:anticheat-catalogs": "tsx --env-file=.env scripts/bootstrap-anticheat-catalogs.ts",
    "sync:full": "SLM_CLI=1 tsx --env-file=.env scripts/run-full-profile-sync.ts",
    "backfill:denuvo": "tsx --env-file=.env scripts/backfill-denuvo-from-catalog.ts",
    "seed:fetch-top-appids": "tsx scripts/fetch-steam-top-sellers.ts --verbose",
    "seed:generate": "tsx --env-file=.env scripts/generate-seed-metadata.ts --verbose",
    "seed:prefetch-appdetails": "tsx --env-file=.env scripts/prefetch-appdetails-only.ts",
    "seed:hydrate": "tsx --env-file=.env scripts/hydrate-seed-data.ts",
    "seed:verify": "tsx --env-file=.env scripts/verify-seed-data.ts",
    "seed:diagnose": "tsx --env-file=.env scripts/diagnose-seed-coverage.ts",
    "seed:export-profiles": "tsx --env-file=.env scripts/export-profile-appids-for-seed.ts",
    "docker:build-db-template": "tsx --env-file=.env scripts/build-docker-db-template.ts",
    "bootstrap": "npx tsx --env-file=.env scripts/bootstrap-full-dashboard.ts",
    "db:migrate": "tsx --env-file=.env scripts/db-migrate.ts",
    "db:verify": "tsx --env-file=.env scripts/db-verify.ts",
    "db:studio": "drizzle-kit studio",
    "store:throttle": "tsx --env-file=.env scripts/reset-steam-store-throttle.ts",
    "store:reset-throttle": "tsx --env-file=.env scripts/reset-steam-store-throttle.ts --reset",
    "test:wishlist": "vitest run src/lib/steam/fetch-wishlist.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "better-sqlite3": "^12.11.1",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.9.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "shadcn": "^4.16.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
